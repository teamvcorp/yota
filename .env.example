# Copy this file to .env.local and fill in real values. .env.local is git-ignored. NEVER commit real keys.
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server and never reach the browser.

# Public site URL (used for metadata / social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (form delivery) -----------------------------------------------------
# Create at https://resend.com/api-keys. Least privilege: a "Sending access" key is enough to
# send the emails, but saving challenge sign-ups as Contacts needs a "Full access" key.
# With a sending-only key, contact saving fails gracefully and the coach still gets an email.
RESEND_API_KEY=
# Must be on a domain you've verified in Resend. For local testing you can use:
#   Yotae <onboarding@resend.dev>  (can only send to your own Resend account email)
RESEND_FROM=
# This project: Yotae Website <website@fyht4.com>
# Inbox that receives intro requests and challenge sign-up notices
CONTACT_TO=
# Optional: Resend segment ID for 7-day challenge subscribers
RESEND_SEGMENT_ID=
